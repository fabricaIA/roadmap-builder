# RoadmapBuilder — backend (FastAPI). Copie para .env e preencha.

# --- GitHub OAuth App (usado SÓ para login) ---
# Crie em: GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL (dev): http://localhost:8000/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- Sessão / segredos ---
# Segredo do JWT que assina o cookie de sessão (troque em produção).
SESSION_SECRET=troque-por-um-valor-aleatorio-longo
# Chave Fernet p/ cifrar o PAT em repouso. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAT_ENCRYPTION_KEY=
# True quando servir por HTTPS.
COOKIE_SECURE=false

# --- Banco ---
# SQLite em dev; em produção use algo como postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./roadmap.db

# --- Front ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
